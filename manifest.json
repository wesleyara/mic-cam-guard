{
  "manifest_version": 3,
  "name": "MicCam Guard",
  "version": "1.1.0",
  "description": "Protects you in online meetings: auto-mute, camera-off, confirmations and warnings for Meet, Teams and Zoom.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/wc/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "src/defaults.js",
        "src/platforms.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MicCam Guard",
    "default_popup": "src/popup.html",
    "default_icon": {
      "128": "src/icon128.png"
    }
  },
  "icons": {
    "128": "src/icon128.png"
  }
}